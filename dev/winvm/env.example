# Copy this file to dev/winvm/env and use absolute paths. Do not commit that file.
WINVM_WINDOWS_ISO=/absolute/path/to/SERVER_EVAL_x64FRE_en-us.iso
WINVM_VIRTIO_ISO=/absolute/path/to/virtio-win-0.1.285.iso

# Optional. The default is ${XDG_CACHE_HOME:-$HOME/.cache}/tor-driver/winvm.
# WINVM_CACHE_DIR=/absolute/path/to/private/cache

# Optional overrides when the Nix development shell cannot find OVMF itself.
# WINVM_OVMF_CODE=/absolute/path/to/OVMF_CODE.fd
# WINVM_OVMF_VARS=/absolute/path/to/OVMF_VARS.fd
